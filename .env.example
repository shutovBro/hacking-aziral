# ─────────────────────────────────────────────────────────────
# Hacking-Aziral — пример переменных окружения.
# Скопируй в .env и заполни. НЕ коммить .env (см. .gitignore).
# Сгенерировать секреты: ./scripts/gen-secrets.sh
# ─────────────────────────────────────────────────────────────

# Базовый домен платформы (для локали можно aziral.localhost)
ROOT_DOMAIN=aziral.localhost
# Email для Let's Encrypt (на проде). Для localhost не используется.
ACME_EMAIL=admin@example.com
# staging|production — на проде ставь production для реальных TLS-сертов
ACME_CA=staging

# ── Postgres (общий кластер; у каждого сервиса своя БД) ──
POSTGRES_USER=aziral
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=aziral

# ── Redis ──
REDIS_PASSWORD=__CHANGE_ME__

# ── Aziral Core ──
CORE_SECRET_KEY=__CHANGE_ME__
# Подключение Core к БД (БД создаётся в init)
CORE_DATABASE_URL=postgresql+psycopg://aziral:__CHANGE_ME__@postgres:5432/aziral_core
CORE_REDIS_URL=redis://:__CHANGE_ME__@redis:6379/0
# Режим scope-gate: enforce (блокировать вне scope) | warn (только лог)
SCOPE_MODE=enforce
# Сервисный ключ для вызовов Core от автоматизации (по внутренней сети)
CORE_INTERNAL_API_KEY=__CHANGE_ME__

# ── Authentik (SSO) ──
AUTHENTIK_SECRET_KEY=__CHANGE_ME__
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_PASSWORD=__CHANGE_ME__
# Внутренний эндпоинт forward-auth (не менять без причины)
AUTHENTIK_OUTPOST_HOST=http://authentik-server:9000
# Bootstrap первого админа (применяется только при инициализации БД)
AUTHENTIK_BOOTSTRAP_PASSWORD=__CHANGE_ME__
AUTHENTIK_BOOTSTRAP_EMAIL=admin@aziral.local
AUTHENTIK_BOOTSTRAP_TOKEN=__CHANGE_ME__

# ── Superset ──
SUPERSET_SECRET_KEY=__CHANGE_ME__
SUPERSET_POSTGRES_DB=superset
SUPERSET_POSTGRES_PASSWORD=__CHANGE_ME__
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=__CHANGE_ME__
SUPERSET_ADMIN_EMAIL=admin@aziral.local

# ── Activepieces ──
AP_API_KEY=__CHANGE_ME__
AP_ENCRYPTION_KEY=__CHANGE_ME__
AP_JWT_SECRET=__CHANGE_ME__
AP_POSTGRES_DB=activepieces
AP_POSTGRES_PASSWORD=__CHANGE_ME__

# ── Cronicle ──
CRONICLE_SECRET=__CHANGE_ME__

# ── sub2api (AI gateway) ──
SUB2API_POSTGRES_DB=sub2api
SUB2API_POSTGRES_PASSWORD=__CHANGE_ME__
SUB2API_JWT_SECRET=__CHANGE_ME__

# ── remnawave ──
REMNAWAVE_JWT_AUTH_SECRET=__CHANGE_ME__
REMNAWAVE_JWT_API_SECRET=__CHANGE_ME__
REMNAWAVE_POSTGRES_DB=remnawave
REMNAWAVE_POSTGRES_PASSWORD=__CHANGE_ME__

# ── AI ключи (опционально; используются через sub2api) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
