# ─────────────────────────────────────────────────────────────────────────
# Расширения платформы: Stirling-PDF, Open WebUI, Uptime Kuma.
#
# Запуск (на проде, за NPM):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     -f docker-compose.extra-modules.yml \
#     --profile pdf --profile webui --profile monitoring up -d
#
# Роуты заданы декларативно в infra/traefik/dynamic/services.yml
# (file-provider). Labels Traefik здесь не используются — будут проигнорированы.
# ─────────────────────────────────────────────────────────────────────────

services:
  # ───────────────────── PDF обработка (profile: pdf) ──────────────────────
  aziralpy-pdf:
    image: docker.stirlingpdf.com/stirlingtools/stirling-pdf:latest
    profiles: [pdf]
    restart: unless-stopped
    environment:
      DOCKER_ENABLE_SECURITY: "true"
      SECURITY_INITIALLOGIN_USERNAME: "admin"
      SECURITY_INITIALLOGIN_PASSWORD: "AziralAdmin2026!"
      SECURITY_CSRFDISABLED: "false"
      SYSTEM_DEFAULTLOCALE: "ru_RU"
      # ─── РЕБРЕНДИНГ AziralPDF ───
      UI_APP_NAME: "AziralPDF"
      UI_APP_NAME_NAVBAR: "AziralPDF"
      UI_HOME_DESCRIPTION: "Профессиональные PDF инструменты от Aziral"
      UI_APP_LOGO: "https://aziral.com/logo.png"
      APP_HOME_NAME: "AziralPDF"
      APP_HOME_DESCRIPTION: "Полный набор инструментов для работы с PDF"
      APP_NAVBAR_NAME: "AziralPDF"
      SYSTEM_GOOGLEVISIBILITY: "false"
      SYSTEM_ENABLEANALYTICS: "false"
      SYSTEM_SHOWUPDATE: "false"
      SYSTEM_SHOWUPDATEONLYADMIN: "true"
      METRICS_ENABLED: "false"
      SHOW_SURVEY: "false"
      LEGAL_TERMSANDCONDITIONS: "https://aziral.com/terms"
      LEGAL_PRIVACYPOLICY: "https://aziral.com/privacy"
      LEGAL_ACCESSIBILITYSTATEMENT: ""
      LEGAL_COOKIEPOLICY: ""
      LEGAL_IMPRESSUM: ""
    volumes:
      - aziralpy-pdf-data:/usr/share/tessdata
      - aziralpy-pdf-config:/configs
      - aziralpy-pdf-logs:/logs
    networks: [edge, internal]
  # ───────────────── Веб-UI к AI моделям (profile: webui) ─────────────────
  open-webui:
    image: ghcr.io/open-webui/open-webui:latest
    profiles: [webui]
    restart: unless-stopped
    environment:
      # Подключается к OpenAI напрямую (sub2api пока не поднят).
      # Если будет поднят sub2api — заменить OPENAI_API_BASE_URL на http://sub2api:8080/v1
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      WEBUI_AUTH: "false"           # SSO через Authentik на уровне Traefik
      ENABLE_SIGNUP: "false"
    volumes:
      - open-webui-data:/app/backend/data
    networks: [edge, internal]

  # ────────────── Мониторинг доступности (profile: monitoring) ────────────
  uptime-kuma:
    image: louislam/uptime-kuma:latest
    profiles: [monitoring]
    restart: unless-stopped
    volumes:
      - uptime-kuma-data:/app/data
    networks: [edge, internal]

volumes:
  aziralpy-pdf-data:
  aziralpy-pdf-config:
  aziralpy-pdf-logs:
  open-webui-data:
  uptime-kuma-data:

networks:
  edge:
    name: aziral_edge
    external: true
  internal:
    name: aziral_internal
    external: true
